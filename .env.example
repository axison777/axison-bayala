# Local development: leave DATABASE_URL and Cloudinary empty to use SQLite.
APP_URL=http://localhost:3000
DATA_DIR=./data
ADMIN_EMAIL=bayalaaxison@gmail.com
# Required for the first remote admin account; minimum 14 characters.
ADMIN_INITIAL_PASSWORD=
# Neon pooled PostgreSQL URL, including its sslmode/channel_binding parameters.
# Server-side only: never use NEXT_PUBLIC_ for these values.
DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
